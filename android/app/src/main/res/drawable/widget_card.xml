<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen player's card when there is no cover, in the widget's own colour; a song's colour is laid over it
     with setColorFilter. Not android:tint in the layout: that would also colour the cover put in its place. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_surface"/>
    <corners android:radius="@dimen/widget_radius"/>
</shape>
