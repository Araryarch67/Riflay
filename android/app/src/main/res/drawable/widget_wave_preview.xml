<?xml version="1.0" encoding="utf-8"?>
<!-- The progress line in the widget picker's preview. PlayerWidget draws the wave itself, at the widget's width. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="center_vertical|fill_horizontal" android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track"/>
            <corners android:radius="2dp"/>
        </shape>
    </item>
</layer-list>
